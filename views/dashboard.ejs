<!DOCTYPE html>
<html>
<head>
  <title>Talkora Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <h2>Talkora</h2>
    <a href="/logout">Logout</a>
  </nav>

  <div class="container">
    <h1>Welcome, <%= user.name %></h1>

    <div class="card">
      <h2>Create New Meeting</h2>
      <form action="/create-room" method="POST">
        <button type="submit">Create Meeting</button>
      </form>
    </div>

    <div class="card">
      <h2>Join Meeting</h2>
      <form action="/join-room" method="POST">
        <input type="text" name="roomId" placeholder="Enter Room ID" required>
        <button type="submit">Join</button>
      </form>
    </div>

    <div class="card">
      <h2>Meeting History</h2>

      <% if (meetings.length === 0) { %>
        <p>No meetings yet.</p>
      <% } %>

      <% meetings.forEach(meeting => { %>
        <div class="history">
          <p><b>Room ID:</b> <%= meeting.roomId %></p>
          <p><b>Date:</b> <%= meeting.createdAt.toLocaleString() %></p>
          <a href="/room/<%= meeting.roomId %>">Join Again</a>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>